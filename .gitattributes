# Akhir baris tetap benar di Windows maupun Linux, apa pun pengaturan Git di PC pengambil.
# Skrip yang berjalan DI DALAM container (Linux) wajib LF; skrip Windows wajib CRLF.
* text=auto
*.sh      text eol=lf
*.py      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.conf    text eol=lf
*.xml     text eol=lf
*.sql     text eol=lf
Dockerfile text eol=lf
*.cmd     text eol=crlf
*.bat     text eol=crlf
*.ps1     text eol=crlf
# Berkas biner: jangan pernah diubah
*.whl   binary
*.zip   binary
*.png   binary
*.jpg   binary
*.pdf   binary
*.xlsx  binary
*.woff2 binary
*.geojson -text
