# =============================================================================
#  .env  -  SATU-SATUNYA tempat mengatur konfigurasi proyek ini.
#  Salin file ini menjadi ".env" lalu isi nilainya (init.ps1 melakukannya otomatis).
#  JANGAN commit file .env ke git (berisi password).
# =============================================================================

# ----- Versi komponen (upgrade/downgrade: docs/16-upgrade-downgrade.md) -----
SUPERSET_VERSION=6.1.0
# PostgreSQL metadata, ClickHouse ALDx Engine (LTS), Redis, nginx gateway
METADB_VERSI=17
ENGINE_VERSI=25.8
REDIS_VERSI=7.4
GATEWAY_VERSI=1.28

# ----- Superset -----
SUPERSET_PORT=8088
# Dibuat otomatis oleh scripts\init.ps1 jika masih bernilai placeholder.
SUPERSET_SECRET_KEY=GANTI_DENGAN_SECRET_KEY

# ----- Metadata DB: PostgreSQL di container "metadb" (katalog dashboard, user, izin) -----
# Node utama selalu memakai container metadb (diatur docker-compose.yml).
# METADB_HOST/PORT hanya diubah di NODE TAMBAHAN (diisi scripts\gabung-node.ps1).
METADB_HOST=metadb
METADB_PORT=5432
METADB_DATABASE=sps_superset
METADB_USER=superset
# Dibuat otomatis oleh installer / init.ps1.
METADB_PASSWORD=GANTI_DENGAN_PASSWORD_METADB
# Port metadb di komputer ini (5433 agar tidak bentrok dengan PostgreSQL lain).
METADB_PORT_HOST=5433
# Diisi "postgres" setelah instalasi/pindah selesai. Jangan diubah manual.
METADB_JENIS=

# Pengaturan MYSQL_* hanya ada pada instalasi LAMA (XAMPP / MariaDB) dan dipakai
# sekali oleh scripts\pindah-metadata.ps1. Instalasi baru tidak memerlukannya.

# ----- ALDx Engine: ClickHouse internal di container "engine" (docs/13) -----
# Tempat ekstrak, upload Excel/CSV, dan hasil prediksi. Terpisah dari database sumber.
ENGINE_HOST=engine
ENGINE_PORT=8123
ENGINE_DATABASE=sps_engine
ENGINE_USER=sps
# Dibuat otomatis oleh installer / init.ps1.
ENGINE_PASSWORD=GANTI_DENGAN_PASSWORD_ENGINE
# Port HTTP engine di komputer ini (untuk node tambahan & diagnosa).
ENGINE_PORT_HOST=8124

# ----- HTTPS (opsional) -----
# 1 = gateway memakai HTTPS di port web yang sama (http:// otomatis dialihkan).
# Sertifikat dibuat otomatis di server\tls\ (self-signed, berlaku 10 tahun) oleh scripts\terapkan-server.ps1.
# Punya sertifikat kantor: taruh sebagai server\tls\aldx.crt + aldx.key (lihat server\tls\README.md).
SPS_HTTPS=
# Nama/IP lain yang dipakai pengguna untuk membuka server, pisah koma (masuk ke sertifikat). Contoh: srv-aldx,10.1.2.3
SPS_HTTPS_NAMA=

# ----- Email langganan laporan (opsional) -----
# Kosong = laporan terjadwal tidak dikirim (hanya dicatat). Isi server SMTP kantor untuk mengirim email.
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=1
SMTP_SSL=
SMTP_USER=
# Password akun email pengirim (rahasia; jangan dibagikan).
SMTP_PASSWORD=
SMTP_MAIL_FROM=

# ----- Peta (Peta titik & kepadatan) -----
# Ubin peta dasar yang diambil browser. Jaringan tanpa internet: isi server ubin lokal.
SPS_PETA_UBIN=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# ----- Akun admin pertama (dipakai sekali oleh init.ps1) -----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=GantiPasswordIni123
ADMIN_EMAIL=admin@localhost
ADMIN_FIRSTNAME=Admin
ADMIN_LASTNAME=ALDx

# ----- Login LDAP / Active Directory (OPSIONAL) -----
# KOSONG = tanpa LDAP: semua akun lokal, dibuat Admin di Settings > List Users.
# Diisi  = login memakai akun AD kantor. Server dicoba berurutan (cadangan bila utama mati).
# Contoh: LDAP_SERVERS=ldaps://dc1.kantor.local,ldaps://dc2.kantor.local
#         LDAP_DOMAIN=KANTOR
#         LDAP_SEARCH_BASE=OU=Karyawan,DC=kantor,DC=local
LDAP_SERVERS=
LDAP_DOMAIN=
LDAP_SEARCH_BASE=
# Role untuk pengguna LDAP yang pertama kali login.
#   Gamma (DISARANKAN): hanya melihat dashboard yang diizinkan.
#   Alpha: boleh membuat dataset dari tabel mana pun -> bisa MELEWATI hak akses
#          data. Berikan Alpha per orang lewat Settings -> List Users saja.
LDAP_DEFAULT_ROLE=Gamma
# Username LDAP (dipisah koma) yang otomatis jadi Admin, contoh: budi.santoso,siti.rahayu
LDAP_ADMIN_USERS=
# Username (LDAP atau lokal, dipisah koma) yang otomatis jadi SUPERADMIN (Admin + pengaturan vital).
# Akun ADMIN_USERNAME selalu Superadmin. Berlaku saat login berikutnya / build-dashboards.
SPS_SUPERADMIN_USERS=
# ----- Masuk dengan SSO / OpenID Connect (OPSIONAL) -----
# Tambahan di samping login password (akun lokal & LDAP tetap bisa dipakai). Kosong = tombol SSO tidak tampil.
# Daftarkan aplikasi di penyedia dengan alamat kembali: https://<alamat-aldx>/sso/kembali  (docs/04 bagian SSO)
# Microsoft Entra ID : https://login.microsoftonline.com/<ID-tenant>/v2.0/.well-known/openid-configuration
# Google Workspace   : https://accounts.google.com/.well-known/openid-configuration
# Keycloak           : https://<server>/realms/<realm>/.well-known/openid-configuration
SSO_DISCOVERY_URL=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
# Label tombol di halaman login, mis. Microsoft
SSO_NAMA=
# Domain email yang boleh masuk (dipisah koma), mis. kantor.co.id. Kosong = semua domain dari penyedia.
SSO_DOMAIN=
# 1 = akun dibuat otomatis saat pertama masuk dengan role SSO_ROLE_BAWAAN; 0 = hanya email yang sudah didaftarkan Admin
SSO_BUAT_AKUN=0
SSO_ROLE_BAWAAN=Gamma
# Isi hanya bila ALDx dibuka lewat proxy dengan alamat lain (alamat lengkap /sso/kembali)
SSO_ALAMAT_KEMBALI=
# Kunci berkas .ald/.aldx "kunci server". Kosong = turunan SUPERSET_SECRET_KEY.
# Isi SAMA di beberapa server agar berkas berkunci server bisa dibuka di server-server itu (docs/25).
SPS_KUNCI_BERKAS=
# Akun lokal (password di database Superset, BUKAN LDAP). Untuk darurat bila LDAP/VPN mati.
AUTH_LOCAL_USERS=admin
# Role dasar yang diberikan ke semua pengguna (menu Studio, Asisten AI, baca dataset).
SPS_ROLE_PENGGUNA=Pengguna

# ----- Identitas & tema (isi AWAL; setelah terpasang ubah di Pusat Kendali > Identitas & Tema) -----
# Preset: netral (Tinta & Sakura: hitam, abu, putih + pink) | neon | navy | hijau | marun | ungu | grafit
SPS_PRESET=netral
SPS_NAMA_APLIKASI=ALDx
SPS_NAMA_PERUSAHAAN=Nama Perusahaan
# Berkas logo di folder branding\ (kosong = logo dibuat otomatis dari nama & warna).
SPS_LOGO=
# Halaman pertama setelah login (kosong = daftar dashboard).
SPS_HALAMAN_DEPAN=
# Diisi 1 oleh installer bila isian di atas diubah; dikosongkan lagi setelah diterapkan.
SPS_IDENTITAS_TERAPKAN=

# ----- Sematkan dashboard ke web / aplikasi lain (OPSIONAL, docs/30) -----
# Asal halaman yang boleh menampilkan dashboard dalam <iframe>, pisah koma. Kosong = tidak ada situs lain.
SPS_SEMATKAN_DOMAIN=
# Rahasia untuk SERVER aplikasi induk meminta token tamu (min. 32 karakter acak). Jangan taruh di halaman web.
SPS_SEMATKAN_KUNCI=
# Umur token tamu dalam menit (bawaan 15).
SPS_SEMATKAN_MENIT=

# ----- Hak akses berbasis profil pengguna (OPSIONAL) -----
# Bawaan kosong: hak akses data diatur per role (Settings > Row Level Security).
# Diisi: nama koneksi sumber profil (mis. tabel karyawan); query & aturan di config/akses.yaml (docs/08).
AKSES_DATABASE=
# Role berawalan ini dikelola otomatis saat login sesuai aturan akses.yaml (bawaan "Akses ").
AKSES_AWALAN_PERAN=

# ----- Asisten AI (/asisten/) — pengaturan model ada di config/ai.yaml -----
# Termudah: isi key lewat aplikasi (panel Asisten AI > ikon sambung, Admin; tersimpan terenkripsi, tanpa restart).
# Key di sini (perlu restart) didahulukan. Kosong = tidak dipakai.
# Model lokal (Ollama/LM Studio/Jan/llama.cpp di Windows) terdeteksi otomatis, tanpa key.
# Gratis (kuota harian): cara membuat key -> installer halaman Asisten AI, tombol "? Cara membuat key".
AI_GEMINI_API_KEY=
AI_GROQ_API_KEY=
AI_OPENROUTER_API_KEY=
AI_CEREBRAS_API_KEY=
AI_MISTRAL_API_KEY=
AI_GITHUB_TOKEN=
# Berbayar / kredit awal
AI_XAI_API_KEY=
AI_OPENAI_API_KEY=
AI_ANTHROPIC_API_KEY=
AI_DEEPSEEK_API_KEY=
# Jaringan kantor dengan SSL inspection: taruh sertifikat CA kantor (.pem) di folder
# certs\ lalu isi, contoh: AI_CA_BUNDLE=/app/certs/ca-kantor.pem. Kosong = bawaan.
AI_CA_BUNDLE=

# ----- Pusat Kendali Server: cache, backgrounder, multi-node (docs/11) -----
# Password Redis (cache server & antrean). Dibuat otomatis oleh init.ps1.
REDIS_PASSWORD=GANTI_DENGAN_PASSWORD_REDIS
# Nama komputer ini di Pusat Kendali (diisi otomatis dengan nama komputer Windows).
NODE_NAMA=
# Mode multi-node: 0.0.0.0 agar node tambahan bisa memakai Redis, metadb & engine node utama.
CLUSTER_BIND=127.0.0.1
# Port akses web langsung tanpa gateway (hanya dari komputer ini, untuk diagnosa).
NODE_WEB_PORT=8089

# >>> SERVER (dikelola scripts\terapkan-server.ps1 - jangan diedit manual)
# <<< SERVER
